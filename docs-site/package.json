{
  "name": "@media-monitor/docs-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "npm run sync && vitepress dev .generated/site",
    "sync": "node scripts/sync-content.mjs",
    "check": "npm run sync && node scripts/check-content.mjs",
    "test:isolation": "node --test scripts/isolation.test.mjs",
    "build": "npm run check && vitepress build .generated/site",
    "preview": "vitepress preview .generated/site",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "markdown-it-container": "4.0.0",
    "mermaid": "11.16.0",
    "vitepress": "1.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1"
  }
}
