#!/usr/bin/env bash
set -euo pipefail
config="${MEDIA_WATCH_CONFIG:-config/media_watch/watches/matias-knowledge-channels.yaml}"
store="${MEDIA_WATCH_STORE:-data/canonical/media_watch}"
evidence="${MEDIA_WATCH_EVIDENCE:-artifacts/runs/channel-watch-matias-knowledge-channels}"
output="${MEDIA_WATCH_DIGEST_ROOT:-artifacts/channel-watch/matias-knowledge-channels/digests}"
limit="${LIMIT_PER_CHANNEL:-5}"
since_args=()
if [[ -n "${SINCE:-}" ]]; then since_args+=(--since "$SINCE"); fi
digest_args=()
if [[ -n "${DIGEST_ID:-}" ]]; then digest_args+=(--digest-id "$DIGEST_ID"); fi
if [[ -z "${YOUTUBE_API_KEY:-}" ]]; then
  echo "YOUTUBE_API_KEY is required for official YouTube uploads acquisition." >&2
  exit 2
fi
python -m apps.media_watch.monitor --config "$config" --limit "$limit" --store-root "$store" --evidence-root "$evidence"
python -m apps.media_watch.digest --config "$config" --limit-per-channel "$limit" --store-root "$store" --output-root "$output" "${since_args[@]}" "${digest_args[@]}"
