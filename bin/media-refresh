#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -n "${PYTHON:-}" ]; then
  PYTHON_BIN="${PYTHON}"
elif [ -x "${ROOT}/.venv/bin/python" ]; then
  PYTHON_BIN="${ROOT}/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
else
  echo "[media-refresh] ERROR: no project Python found" >&2
  exit 2
fi

exec "${PYTHON_BIN}" "${ROOT}/scripts/media_refresh.py" --repo-root "${ROOT}" "$@"
