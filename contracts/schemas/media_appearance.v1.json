{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor/contracts/media_appearance.v1.json",
  "title": "media_appearance.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "media_appearance.v1"},
    "schema_status": {"const": "experimental"},
    "appearance_id": {"type": "string", "minLength": 8},
    "person_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "item_uid": {"type": "string", "pattern": "^youtube:[A-Za-z0-9_-]{6,32}$"},
    "segment_id": {"type": ["string", "null"]},
    "evidence_source": {
      "enum": ["title", "description", "publisher_metadata", "transcript", "operator_curated", "model_extraction"]
    },
    "matched_alias": {"type": "string", "minLength": 1},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "required": [
    "schema_name", "schema_status", "appearance_id", "person_id", "item_uid", "segment_id",
    "evidence_source", "matched_alias", "confidence", "observed_at"
  ]
}
