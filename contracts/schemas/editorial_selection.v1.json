{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor/contracts/editorial_selection.v1.json",
  "title": "editorial_selection.v1",
  "description": "Deterministic, non-LLM shortlist of monitored source signals. Selection never implies authorship or publication approval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "editorial_selection.v1"},
    "selection_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest_at": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{2}$"},
    "as_of": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["policy_id", "policy_version", "policy_sha256"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "eligible_count": {"type": "integer", "minimum": 0},
        "deduplicated_count": {"type": "integer", "minimum": 0},
        "discarded_stale_count": {"type": "integer", "minimum": 0},
        "discarded_missing_identity_count": {"type": "integer", "minimum": 0},
        "selected_count": {"type": "integer", "minimum": 0}
      },
      "required": [
        "candidate_count",
        "eligible_count",
        "deduplicated_count",
        "discarded_stale_count",
        "discarded_missing_identity_count",
        "selected_count"
      ]
    },
    "selected": {
      "type": "array",
      "items": {"$ref": "#/$defs/selected_signal"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs_path": {"type": "string", "minLength": 1},
        "refs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_path": {"type": "string", "minLength": 1},
        "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["refs_path", "refs_sha256", "policy_path", "policy_sha256"]
    }
  },
  "required": ["schema_name", "selection_id", "digest_at", "as_of", "policy", "metrics", "selected", "provenance"],
  "$defs": {
    "score_components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic_priority": {"type": "integer"},
        "freshness": {"type": "integer"},
        "first_source_bonus": {"type": "integer"},
        "first_topic_bonus": {"type": "integer"},
        "repeat_source_penalty": {"type": "integer", "maximum": 0},
        "repeat_topic_penalty": {"type": "integer", "maximum": 0}
      },
      "required": [
        "topic_priority",
        "freshness",
        "first_source_bonus",
        "first_topic_bonus",
        "repeat_source_penalty",
        "repeat_topic_penalty"
      ]
    },
    "selected_signal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "index_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "link": {"type": "string", "format": "uri"},
        "source": {"type": "string", "minLength": 1},
        "score": {"type": "integer"},
        "score_components": {"$ref": "#/$defs/score_components"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        }
      },
      "required": [
        "rank",
        "index_id",
        "title",
        "topic",
        "published_at",
        "link",
        "source",
        "score",
        "score_components",
        "reason_codes"
      ]
    }
  }
}
