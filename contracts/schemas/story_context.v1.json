{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor/contracts/story_context.v1.json",
  "title": "story_context.v1",
  "description": "Deterministic source-side coverage context for one monitored signal. It is a read model only and never confers authorship or publication approval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "story_context.v1"},
    "context_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest_at": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{2}$"},
    "index_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "coverage_first_published_at": {"type": "string", "format": "date-time"},
    "coverage_latest_published_at": {"type": "string", "format": "date-time"},
    "coverage_count": {"type": "integer", "minimum": 1},
    "source_count": {"type": "integer", "minimum": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "group_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "window_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "related_signals": {
      "type": "array",
      "items": {"$ref": "#/$defs/related_signal"}
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected": {"type": "boolean"},
        "rank": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "score": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        }
      },
      "required": ["selected", "rank", "score", "reason_codes"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs_path": {"type": "string", "minLength": 1},
        "refs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "groups_path": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "groups_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
        "editorial_selection_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["refs_path", "refs_sha256", "groups_path", "groups_sha256", "editorial_selection_id"]
    }
  },
  "required": [
    "schema_name",
    "context_id",
    "digest_at",
    "index_id",
    "topic",
    "coverage_first_published_at",
    "coverage_latest_published_at",
    "coverage_count",
    "source_count",
    "sources",
    "group_ids",
    "window_types",
    "related_signals",
    "curation",
    "provenance"
  ],
  "$defs": {
    "related_signal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "link": {"type": "string", "format": "uri"}
      },
      "required": ["index_id", "title", "source", "published_at", "link"]
    }
  }
}
