{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor/contracts/site_snapshot.v4.json",
  "title": "site_snapshot.v4",
  "description": "Immutable public snapshot separating approved publication, deterministic curation, chronological monitored signals, and source-side story context read models.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "site_snapshot.v4"},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "site": {"$ref": "#/$defs/site"},
    "digest_at": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "ok"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_count": {"type": "integer", "minimum": 1},
        "section_count": {"type": "integer", "minimum": 1},
        "published_article_count": {"type": "integer", "minimum": 0},
        "curated_signal_count": {"type": "integer", "minimum": 1},
        "story_context_count": {"type": "integer", "minimum": 1}
      },
      "required": ["item_count", "section_count", "published_article_count", "curated_signal_count", "story_context_count"]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "featured": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/publication_ref"}]},
        "latest": {"type": "array", "items": {"$ref": "#/$defs/publication_ref"}}
      },
      "required": ["featured", "latest"]
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hero": {"$ref": "#/$defs/signal_item"},
        "curated": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/curated_signal"}},
        "latest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signal_item"}},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signal_section"}}
      },
      "required": ["hero", "curated", "latest", "sections"]
    },
    "story_contexts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/story_context"}
    },
    "articles": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"$ref": "#/$defs/published_article"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs_path": {"type": "string", "minLength": 1},
        "refs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "groups_path": {"type": "string", "minLength": 1},
        "groups_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "published_articles_path": {"type": "string", "minLength": 1},
        "published_articles_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "editorial_selection_path": {"type": "string", "minLength": 1},
        "editorial_selection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "editorial_selection_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "editorial_selection_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "story_contexts_path": {"type": "string", "minLength": 1},
        "story_contexts_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "git_sha": {"type": "string", "minLength": 1}
      },
      "required": [
        "refs_path", "refs_sha256", "groups_path", "groups_sha256",
        "published_articles_path", "published_articles_sha256",
        "editorial_selection_path", "editorial_selection_sha256",
        "editorial_selection_id", "editorial_selection_policy_sha256",
        "story_contexts_path", "story_contexts_sha256", "git_sha"
      ]
    }
  },
  "required": ["schema_name", "snapshot_id", "site", "digest_at", "generated_at", "status", "metrics", "publication", "signals", "story_contexts", "articles", "provenance"],
  "$defs": {
    "site": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "site_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "tagline": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1}
      },
      "required": ["site_id", "name", "tagline", "locale"]
    },
    "signal_item": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "index_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "link": {"type": "string", "format": "uri"},
        "source": {"type": "string"}
      },
      "required": ["index_id", "title", "topic", "published_at", "link", "source"]
    },
    "score_components": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "topic_priority": {"type": "integer"},
        "freshness": {"type": "integer"},
        "first_source_bonus": {"type": "integer"},
        "first_topic_bonus": {"type": "integer"},
        "repeat_source_penalty": {"type": "integer", "maximum": 0},
        "repeat_topic_penalty": {"type": "integer", "maximum": 0}
      },
      "required": ["topic_priority", "freshness", "first_source_bonus", "first_topic_bonus", "repeat_source_penalty", "repeat_topic_penalty"]
    },
    "curated_signal": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "index_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "link": {"type": "string", "format": "uri"},
        "source": {"type": "string"},
        "score": {"type": "integer"},
        "score_components": {"$ref": "#/$defs/score_components"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}
      },
      "required": ["rank", "index_id", "title", "topic", "published_at", "link", "source", "score", "score_components", "reason_codes"]
    },
    "signal_section": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "article_count": {"type": "integer", "minimum": 0},
        "top_titles": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["topic", "article_count", "top_titles"]
    },
    "related_signal": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "index_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "link": {"type": "string", "format": "uri"}
      },
      "required": ["index_id", "title", "source", "published_at", "link"]
    },
    "story_context": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_name": {"const": "story_context.v1"},
        "context_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "digest_at": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{2}$"},
        "index_id": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "coverage_first_published_at": {"type": "string", "format": "date-time"},
        "coverage_latest_published_at": {"type": "string", "format": "date-time"},
        "coverage_count": {"type": "integer", "minimum": 1},
        "source_count": {"type": "integer", "minimum": 1},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "window_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "related_signals": {"type": "array", "items": {"$ref": "#/$defs/related_signal"}},
        "curation": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "selected": {"type": "boolean"},
            "rank": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "score": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
            "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}
          },
          "required": ["selected", "rank", "score", "reason_codes"]
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "refs_path": {"type": "string", "minLength": 1},
            "refs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "groups_path": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
            "groups_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
            "editorial_selection_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["refs_path", "refs_sha256", "groups_path", "groups_sha256", "editorial_selection_id"]
        }
      },
      "required": ["schema_name", "context_id", "digest_at", "index_id", "topic", "coverage_first_published_at", "coverage_latest_published_at", "coverage_count", "source_count", "sources", "group_ids", "window_types", "related_signals", "curation", "provenance"]
    },
    "publication_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "article_id": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "required": ["article_id", "slug", "title", "summary", "topic", "published_at", "updated_at"]
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "citation_id": {"type": "string", "minLength": 1},
        "claim_text": {"type": "string", "minLength": 1},
        "source_ref_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      },
      "required": ["citation_id", "claim_text", "source_ref_id", "url"]
    },
    "published_article": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_name": {"const": "published_article.v1"},
        "article_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "digest_at": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{2}$"},
        "story_group_id": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "body_md": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "source_links": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "status": {"const": "published"},
        "review_status": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "required": ["schema_name", "article_id", "draft_id", "digest_at", "story_group_id", "slug", "title", "summary", "body_md", "topic", "source_links", "citations", "status", "review_status", "published_at", "updated_at"]
    }
  }
}
