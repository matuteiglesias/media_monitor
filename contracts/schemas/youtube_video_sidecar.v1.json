{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor/contracts/youtube_video_sidecar.v1.json",
  "title": "youtube_video_sidecar.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "youtube_video_sidecar.v1"},
    "schema_status": {"const": "experimental"},
    "item_uid": {"type": "string", "pattern": "^youtube:[A-Za-z0-9_-]{6,32}$"},
    "video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{6,32}$"},
    "canonical_url": {"type": "string", "format": "uri"},
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_uid": {"type": ["string","null"], "pattern": "^youtube-channel:[A-Za-z0-9_-]{6,64}$"},
        "source_id": {"type": "string", "minLength": 3},
        "native_channel_id": {"type": ["string","null"]},
        "display_name": {"type": ["string","null"]}
      },
      "required": ["source_uid","source_id","native_channel_id","display_name"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"const": "available"},
        "snapshot_id": {"type": ["string","null"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "published_at": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": ["integer","null"], "minimum": 0},
        "availability": {"type": ["string","null"]},
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "view_count": {"type": ["integer","null"], "minimum": 0},
            "like_count": {"type": ["integer","null"], "minimum": 0},
            "comment_count": {"type": ["integer","null"], "minimum": 0}
          },
          "required": ["view_count","like_count","comment_count"]
        }
      },
      "required": ["state","snapshot_id","observed_at","title","description","published_at","duration_seconds","availability","statistics"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["available","not_attempted","provider_limit","failed"]},
        "summary_id": {"type": ["string","null"]},
        "summary": {"type": ["string","null"]},
        "key_points": {"type": "array", "items": {"type": "string"}},
        "provider": {"type": ["string","null"]},
        "model": {"type": ["string","null"]},
        "prompt_version": {"type": ["string","null"]},
        "adapter_version": {"type": ["string","null"]},
        "processing_mode": {"type": ["string","null"]},
        "generated_at": {"type": ["string","null"], "format": "date-time"},
        "latest_attempt_id": {"type": ["string","null"]},
        "retryable": {"type": ["boolean","null"]}
      },
      "required": ["state","summary_id","summary","key_points","provider","model","prompt_version","adapter_version","processing_mode","generated_at","latest_attempt_id","retryable"]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "available": {"type": "boolean"},
        "preferred_text_asset_id": {"type": ["string","null"]},
        "timing_available": {"type": "boolean"}
      },
      "required": ["state","available","preferred_text_asset_id","timing_available"]
    },
    "segments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "segment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "required": ["count","segment_ids"]
    },
    "appearances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "appearance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "required": ["count","appearance_ids"]
    }
  },
  "required": ["schema_name","schema_status","item_uid","video_id","canonical_url","channel","metadata","summary","text","segments","appearances"]
}
