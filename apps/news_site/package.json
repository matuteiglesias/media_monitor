{
  "name": "news-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "refresh-data": "node scripts/refresh_public_data.mjs",
    "smoke:public-data": "node scripts/validate_public_data.mjs",
    "test:refresh-data": "node --test scripts/refresh_public_data.test.mjs",
    "test:site-snapshot": "node --test scripts/site_snapshot_digest.test.mjs",
    "test:freshness": "node --test scripts/publication_health.test.mjs",
    "prebuild": "node scripts/validate_site_snapshot_for_build.mjs"
  },
  "dependencies": {
    "next": "14.2.25",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.25",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "@tailwindcss/typography": "^0.5.15",
    "typescript": "^5.6.3"
  }
}
